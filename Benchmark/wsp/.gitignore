# Secrets
.env
.env.*

# Python / uv
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Large local artifacts (re-create with `uv run python download.py`)
Qwen3.5-0.8B/
data/
cache/

# Agent run outputs: weight deltas and per-run logs
*.safetensors
results/agent_*/
agent_run.log
nohup.out
*.log

# MLflow local stores (the server writes these if started from this folder)
mlruns/
mlartifacts/
mlflow.db

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

.env/

# --- Results ---------------------------------------------------------------
# Regenerable aggregate of the local runs: uv run python agent.py --aggregate-only
results/all_runs.csv

# Cloud GPU (L4) run folders, results/l4_*/: ignore the raw dumps pulled back from the VM
# (tgz archives, code/lockfile copies, MLflow DB, logs, weight deltas) but keep the analysis data:
# per-run iteration_results.csv, summary.json, metrics/predictions JSON, transcript, and the run scripts.
results/*
# ...except the analysis data of the H100 Qwen3.8-27B agent run (small JSON/CSV/transcript; raw dumps stay ignored)
!results/h100_*/
results/h100_*/*.tgz
results/h100_*/**/*.safetensors
results/h100_*/**/*.db
results/h100_*/**/mlartifacts/
